generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Booking {
  id          String   @id @default(cuid())
  site        String   @db.VarChar(50)
  startTime   DateTime
  endTime     DateTime
  duration    Int
  lastName    String
  firstName   String?
  email       String?
  company     String
  phone       String
  meetingType  String   @db.VarChar(50)
  userTimezone String   @default("Asia/Shanghai") @db.VarChar(50)
  status       String   @default("confirmed") @db.VarChar(20)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([site, startTime])
  @@index([site, status])
}

model AvailabilityConfig {
  id        String  @id @default(cuid())
  site      String  @db.VarChar(50)
  dayOfWeek Int     // 0=周日, 1=周一, ..., 6=周六
  startTime String  @db.VarChar(5)  // "09:00"
  endTime   String  @db.VarChar(5)  // "18:00"
  isActive  Boolean @default(true)

  @@unique([site, dayOfWeek])
}

model BreakTime {
  id        String  @id @default(cuid())
  site      String  @db.VarChar(50)
  dayOfWeek Int?    // null = 每天生效
  startTime String  @db.VarChar(5)  // "12:00"
  endTime   String  @db.VarChar(5)  // "14:00"
  isActive  Boolean @default(true)
}

model Holiday {
  id        String   @id @default(cuid())
  site      String   @db.VarChar(50)
  date      String   @db.VarChar(10) // "yyyy-MM-dd"
  reason    String?  @db.VarChar(100)
  createdAt DateTime @default(now())

  @@unique([site, date])
  @@index([site, date])
}

model Store {
  id               String   @id @default(cuid())
  name             String   @unique @db.VarChar(50)  // 店铺名称/标识
  isBookingEnabled Boolean  @default(false) @map("is_booking_enabled")  // 预约功能开关
  maxFileSize      Int      @default(52428800) @map("max_file_size")    // 最大文件大小（字节），默认50MB
  allowedFileTypes String   @default("*") @map("allowed_file_types")   // 允许的文件类型，* 表示全部，或逗号分隔如 .jpg,.png,.pdf
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users User[]

  @@map("stores")
}

model UploadedFile {
  id         String   @id @default(cuid())
  site       String   @db.VarChar(50)
  fileName   String   @map("file_name") @db.VarChar(500)
  fileKey    String   @map("file_key") @db.VarChar(500)
  fileUrl    String   @map("file_url") @db.VarChar(1000)
  fileSize   Int      @map("file_size")
  mimeType   String   @map("mime_type") @db.VarChar(200)
  uploadedBy String?  @map("uploaded_by") @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([site])
  @@index([site, createdAt])
  @@map("uploaded_files")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique @db.VarChar(50)  // 用户名（店铺名或 admin）
  password  String   @db.VarChar(255)         // 密码哈希
  role      String   @default("site") @db.VarChar(20)  // super 或 site
  site      String?  @db.VarChar(50)          // 店铺名称（site 角色才有）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store? @relation(fields: [site], references: [name], onDelete: Cascade)
}
